<mujoco model="MuJoCo Model">
  <compiler angle="radian" />

  <option timestep="0.02" integrator="RK4" />

  <visual>
    <global offwidth="200" offheight="200" />
  </visual>

  <default>
    <joint limited="false" />
    <geom conaffinity="0" friction="1 0.5 0.5" density="100" material="self" />
  </default>

  <asset>
    <texture type="skybox" colorspace="auto" builtin="gradient" rgb1="1 1 1" rgb2="0 0 0" width="100" height="600" />
    <texture type="2d" colorspace="auto" name="grid" builtin="checker" rgb1="0.08 0.11 0.16" rgb2="0.15 0.18 0.25" width="300" height="300" />
    <texture type="cube" colorspace="auto" name="texgeom" builtin="flat" mark="cross" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" markrgb="1 1 1" width="127" height="762" />
    <texture type="2d" colorspace="auto" name="teleport_in" builtin="gradient" rgb1="0.1 0.1 0.1" rgb2="0.35 0.55 0.91" width="300" height="300" />
    <texture type="2d" colorspace="auto" name="teleport_out" builtin="gradient" rgb1="0.9 0.9 0.9" rgb2="0.35 0.55 0.91" width="300" height="300" />
    <material name="grid" texture="grid" texuniform="true" />
    <material name="self" rgba="0.7 0.5 0.3 1" />
    <material name="geom" texture="texgeom" texuniform="true" />
    <material name="wall" />
    <material name="target" rgba="0.96 0.26 0.33 1" />
    <material name="teleport_in" texture="teleport_in" />
    <material name="teleport_out" texture="teleport_out" />
  </asset>

  <worldbody>
