g", "is_sleeping", "player_level", "light_level", "rng_half0", "rng_half1", "rng_half2", "rng_half3", "inv_health", "inv_food", "inv_drink", "inv_energy", "inv_mana", "inv_xp", "inv_dexterity", "inv_strength", "inv_intelligence", "inv_wood", "inv_stone", "inv_coal", "inv_iron", "inv_diamond", "inv_sapphire", "inv_ruby", "inv_sapling", "inv_torches", "inv_books", "inv_arrows", "inv_potion0", "inv_potion1", "inv_potion2", "inv_potion3", "inv_potion4", "inv_potion5", "inv_pickaxe", "inv_sword", "inv_bow", "inv_armour0", "inv_armour1", "inv_armour2", "inv_armour3", "inv_ench_sword", "inv_ench_bow", "inv_ench_armour0", "inv_ench_armour1", "inv_ench_armour2", "inv_ench_armour3", "inv_spell_fireball", "inv_spell_iceball"], "step_reference_exact": null, "step_reference_control": null, "step_reference_gate": null, "class": "CraftaxFull", "module": "stable_envs.envs.craftax_full", "doc": "Full Craftax: nine levels, an item/mob/projectile stencil over a block window, and a 4-row strip.\n\n**The render window is wider than the reference bridge in one place, and it is stated here rather\nthan discovered.** The window has room for a projectile on each of its 99 tiles; an ``EnvState``\nhas room for ``MAX_MOB_PROJ + MAX_PLAYER_PROJ`` = **6**, because its two projectile masks are\n``(9, 3)`` each and a seventh cannot exist in a state at all. A window carrying seven renders\nhere and **cannot be scored against the reference**, which places six and drops the rest.\n:meth:`sample_states` never produces such a row and\n``tests/unit/test_craftax_full.py::test_a_window_carrying_more_projectiles_than_the_simulator_can_hold_is_not_representable``\nasserts both halves. The boundary pool keeps one such row deliberately, scored apart\n(``examples/results/step7/craftax-full/certify/boundary_pool.json``).", "has_step": false, "render_overridden": true, "backends": ["prng"]}, "Crafter": {"name": "crafter", "reference_id": "CrafterReward-v1", "fidelity_tier": "parity", "render_decoder": "renderer"