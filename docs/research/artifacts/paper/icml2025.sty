%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% icml2025.sty -- ICML-style two-column layout, self-contained.
%
% NOT the file distributed by the ICML organisers. This directory has to build
% with no network and no styles outside a stock TeX Live, so the layout is
% reimplemented here from the published page specification: US Letter, a
% 6.75in x 9.0in text block, two 3.25in columns with a 0.25in gutter, 10pt
% Times, a 14pt bold centred title, a running head, and the affiliation and
% notice footnote at the foot of the first column of page 1.
%
% The author-facing macros are the ones the official style defines
% (\icmltitle, \icmltitlerunning, icmlauthorlist, \icmlauthor,
% \icmlaffiliation, \icmlcorrespondingauthor, \icmlsetsymbol, \icmlkeywords,
% \printAffiliationsAndNotice, \icmlEqualContribution), so the same main.tex
% builds against the official icml2025.sty by swapping this file out.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icml2025}[2025/01/01 ICML-style layout (self-contained)]

\newif\ificml@accepted \icml@acceptedfalse
\DeclareOption{accepted}{\icml@acceptedtrue}
\DeclareOption{nohyperref}{}
\DeclareOption*{}
\ProcessOptions\relax

\RequirePackage{fancyhdr}
\RequirePackage{graphicx}
\IfFileExists{times.sty}{\RequirePackage{times}}{}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% page layout %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\setlength{\paperwidth}{8.5in}
\setlength{\paperheight}{11in}
\ifx\pdfpagewidth\undefined\else
  \setlength{\pdfpagewidth}{8.5in}
  \setlength{\pdfpageheight}{11in}
\fi

\setlength{\textwidth}{6.75in}
\setlength{\textheight}{9.0in}
\setlength{\columnsep}{0.25in}
\setlength{\oddsidemargin}{-0.125in}   % 1in + this = 0.875in, centring the block
\setlength{\evensidemargin}{-0.125in}
\setlength{\topmargin}{-0.5in}         % 1in + this + head = 1.01in to the body
\setlength{\headheight}{12pt}
\setlength{\headsep}{25pt}
\setlength{\footskip}{0.4in}
\setlength{\marginparwidth}{0pt}
\setlength{\marginparsep}{0pt}

\setlength{\parindent}{0.2in}
\setlength{\parskip}{0pt}
\setlength{\floatsep}{0.13in}
\setlength{\textfloatsep}{0.16in}
\setlength{\intextsep}{0.13in}
\setlength{\dblfloatsep}{0.13in}
\setlength{\dbltextfloatsep}{0.16in}
\setlength{\abovecaptionskip}{5pt}
\setlength{\belowcaptionskip}{2pt}
\renewcommand{\topfraction}{0.95}
\renewcommand{\bottomfraction}{0.8}
\renewcommand{\textfraction}{0.05}
\renewcommand{\floatpagefraction}{0.8}
\renewcommand{\dbltopfraction}{0.95}
\renewcommand{\dblfloatpagefraction}{0.8}
\setcounter{topnumber}{4}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{6}
\setcounter{dbltopnumber}{3}

%%%%%%%%%%%%%%%%%%%%%%%%%%%% headings and captions %%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\makeatletter
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-0.24in \@plus -1ex \@minus -0.2ex}{0.10in \@plus 0.2ex}{\large\bfseries\raggedright}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-0.18in \@plus -1ex \@minus -0.2ex}{0.06in \@plus 0.2ex}{\normalsize\bfseries\raggedright}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-0.14in \@plus -1ex \@minus -0.2ex}{0.04in \@plus 0.2ex}{\normalsize\itshape\raggedright}}
\renewcommand\paragraph{\@startsection{paragraph}{4}{\z@}%
  {0.10in \@plus 0.5ex}{-1em}{\normalsize\bfseries}}

\long\def\@makecaption#1#2{%
  \vskip\abovecaptionskip
  \sbox\@tempboxa{\small #1. #2}%
  \ifdim\wd\@tempboxa>\hsize
    {\small #1. #2\par}%
  \else
    \global\@minipagefalse\hb@xt@\hsize{\hfil\box\@tempboxa\hfil}%
  \fi
  \vskip\belowcaptionskip}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% running head %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\gdef\@icmltitlerunning{}
\newcommand{\icmltitlerunning}[1]{\gdef\@icmltitlerunning{#1}}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\small\@icmltitlerunning}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{icml@first}{%
  \fancyhf{}\fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% title and authors %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcounter{icml@affil}
\gdef\@icmlauthors{}
\gdef\@icmlafflabels{}
\gdef\@icmlcorr{}
\gdef\@icmlkeywords{}

\newcommand{\icmlsetsymbol}[2]{\expandafter\gdef\csname icml@sym@#1\endcsname{#2}}
\icmlsetsymbol{equal}{*}
\newcommand{\icmlEqualContribution}{\textsuperscript{*}Equal contribution. }

% Affiliation numbers are assigned in the order the labels are first used in the
% author list, which is what makes the superscripts read 1, 2, 3 left to right.
% \icml@ensure only registers; \icml@num registers and typesets the number.
\newcommand{\icml@ensure}[1]{%
  \@ifundefined{icml@aff@#1}{%
    \stepcounter{icml@affil}%
    \expandafter\xdef\csname icml@aff@#1\endcsname{\the\value{icml@affil}}%
    \ifx\@icmlafflabels\@empty
      \gdef\@icmlafflabels{#1}%
    \else
      \expandafter\gdef\expandafter\@icmlafflabels\expandafter{\@icmlafflabels,#1}%
    \fi
  }{}}
\newcommand{\icml@num}[1]{\icml@ensure{#1}\csname icml@aff@#1\endcsname}

\newcommand{\icml@marks}[1]{%
  \def\icml@sep{}%
  \@for\icml@lab:=#1\do{%
    \icml@sep
    \@ifundefined{icml@sym@\icml@lab}%
      {\expandafter\icml@num\expandafter{\icml@lab}}%
      {\csname icml@sym@\icml@lab\endcsname}%
    \def\icml@sep{,}}}

\newcommand{\icmlauthor}[2]{%
  \ifx\@icmlauthors\@empty\else\g@addto@macro\@icmlauthors{,\ }\fi
  \g@addto@macro\@icmlauthors{#1\textsuperscript{\icml@marks{#2}}}}

\newcommand{\icmlaffiliation}[2]{%
  \icml@ensure{#1}%
  \expandafter\gdef\csname icml@afftext@#1\endcsname{#2}}

\newcommand{\icmlcorrespondingauthor}[2]{%
  \gdef\@icmlcorr{Correspondence to: #1 \textless\texttt{#2}\textgreater.}}

\newcommand{\icmlkeywords}[1]{\gdef\@icmlkeywords{#1}}

\newenvironment{icmlauthorlist}{}{%
  \vskip 0.12in
  \begin{center}\large\@icmlauthors\end{center}}

\newcommand{\icmltitle}[1]{%
  \ifx\@icmltitlerunning\@empty\gdef\@icmltitlerunning{#1}\fi
  \thispagestyle{icml@first}%
  \vskip 0.20in
  \begin{center}%
    \parbox{\textwidth}{\centering\Large\bfseries #1\par}%   % 14pt, as specified
  \end{center}}

\newcommand{\icml@afflist}{%
  \def\icml@sep{}%
  \@for\icml@lab:=\@icmlafflabels\do{%
    \icml@sep
    \textsuperscript{\csname icml@aff@\icml@lab\endcsname}%
    \@ifundefined{icml@afftext@\icml@lab}{}{\csname icml@afftext@\icml@lab\endcsname}%
    \def\icml@sep{, }}%
  \unskip. }

\newcommand{\icml@notice}{%
  \ificml@accepted
    Proceedings of the \textit{42\textsuperscript{nd} International Conference on Machine
    Learning}. Copyright 2025 by the author(s).
  \else
    Preliminary work. Under review. Do not distribute.
  \fi}

\newcommand{\printAffiliationsAndNotice}[1]{%
  \begingroup
    \let\@makefnmark\relax
    \renewcommand{\thefootnote}{}%
    \renewcommand{\@makefntext}[1]{\noindent ##1}%
    \footnotetext{\footnotesize #1\icml@afflist\@icmlcorr\ \icml@notice}%
  \endgroup}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% abstract %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \vspace{0.6ex}%
  \begin{list}{}{\setlength{\leftmargin}{0.15in}\setlength{\rightmargin}{0.15in}%
                 \setlength{\listparindent}{\parindent}\setlength{\itemindent}{0pt}%
                 \setlength{\parsep}{0pt}\setlength{\topsep}{0pt}}%
  \item[]\small}%
  {\end{list}\vskip 0.10in}
\makeatother

\endinput
